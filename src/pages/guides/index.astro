---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
const allGuides = (await getCollection('guides', ({ data }) => !data.draft))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
---
<Layout title="Guides" description="Practical nature guides for Carlsbad — family outings, birding for beginners, tide pool timing, gear tips, and audio trail guides." section="Guides">
  <section class="hero" style="padding:3rem 0 2.5rem; background:linear-gradient(160deg, var(--color-ink) 0%, var(--color-sage) 100%);">
    <div class="container" style="position:relative;z-index:1;">
      <span class="eyebrow">Family · Birding · Tide Pools · Gear · Audio Trails</span>
      <h1>Guides</h1>
      <p style="max-width:55ch;">Practical guidance for getting out there — from first-timer introductions to detailed field tips.</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <h2>All Guides</h2>
      {allGuides.length > 0 ? (<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(260px,1fr)); gap:1.5rem; margin-top:1.5rem;">{allGuides.map(guide => (<a href={`/guides/${guide.id}`} class="card" style="text-decoration:none; display:block;"><div class="card-body"><p class="card-title">{guide.data.title}</p><p class="card-desc">{guide.data.description}</p></div></a>))}</div>) : (<p style="color:var(--color-stone); font-style:italic;">Guides coming soon.</p>)}
    </div>
  </section>
</Layout>
