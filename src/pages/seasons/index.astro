---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
const allSeasons = (await getCollection('seasons', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<Layout title="Seasons" description="What's happening in Carlsbad nature every season — spring wildflowers, fall Pacific Flyway migration, winter shorebirds, and summer marine life." section="Seasons">
  <section class="hero" style="padding:3rem 0 2.5rem; background:linear-gradient(160deg, var(--color-dusk) 0%, var(--color-sand) 100%);">
    <div class="container" style="position:relative;z-index:1;">
      <span class="eyebrow">What's Happening in Carlsbad Nature</span>
      <h1>Seasons</h1>
      <p style="max-width:55ch;">Something remarkable is happening every month — migration, breeding, wildflowers, tidal life.</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <h2>Seasonal Guides</h2>
      {allSeasons.length > 0 ? (<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(260px,1fr)); gap:1.5rem; margin-top:1.5rem;">{allSeasons.map(article => (<a href={`/seasons/${article.id}`} class="card" style="text-decoration:none; display:block;"><div class="card-body"><p class="card-title">{article.data.title}</p><p class="card-desc">{article.data.description}</p></div></a>))}</div>) : (<p style="color:var(--color-stone); font-style:italic;">Seasonal guides coming soon.</p>)}
    </div>
  </section>
</Layout>
