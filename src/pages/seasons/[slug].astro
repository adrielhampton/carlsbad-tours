---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const articles = await getCollection('seasons', ({ data }) => !data.draft);
  return articles.map(article => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const { title, description, pubDate, updatedDate, author, authorCredential, tags, season, month } = article.data;

const eyebrowParts = ['Seasons'];
if (season) eyebrowParts.push(season.charAt(0).toUpperCase() + season.slice(1));
if (month) eyebrowParts.push(month);
---

<ArticleLayout
  title={title}
  description={description}
  pubDate={pubDate}
  updatedDate={updatedDate}
  author={author}
  authorCredential={authorCredential}
  section="Seasons"
  eyebrow={eyebrowParts.join(' · ')}
  tags={tags}
>
  <Content />
</ArticleLayout>
