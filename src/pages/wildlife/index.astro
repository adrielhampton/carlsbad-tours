---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
const allWildlife = (await getCollection('wildlife', ({ data }) => !data.draft))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
---
<Layout title="Wildlife" description="Birds, marine life, coastal sage scrub plants, and lagoon wildlife of Carlsbad and North County San Diego." section="Wildlife">
  <section class="hero" style="padding:3rem 0 2.5rem; background:linear-gradient(160deg, var(--color-sage) 0%, var(--color-lagoon) 100%);">
    <div class="container" style="position:relative;z-index:1;">
      <span class="eyebrow">Birds, Marine Life, Plants & Habitats</span>
      <h1>Wildlife</h1>
      <p style="max-width:55ch;">What lives here, where to find it, and what to look for.</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <h2>Wildlife Guides</h2>
      {allWildlife.length > 0 ? (<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(260px,1fr)); gap:1.5rem; margin-top:1.5rem;">{allWildlife.map(article => (<a href={`/wildlife/${article.id}`} class="card" style="text-decoration:none; display:block;"><div class="card-body"><p class="card-title">{article.data.title}</p><p class="card-desc">{article.data.description}</p></div></a>))}</div>) : (<p style="color:var(--color-stone); font-style:italic;">Wildlife guides coming soon.</p>)}
    </div>
  </section>
</Layout>
