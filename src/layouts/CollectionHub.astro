---
import Base from './Base.astro';

export interface Props {
  title:       string;
  description: string;
  collection:  string;
  intro:       string;
  entries:     any[];
}

const { title, description, collection, intro, entries } = Astro.props;
---

<Base title={title} description={description}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">

    <header class="max-w-2xl mb-12">
      <p class="text-xs uppercase tracking-widest text-lagoon mb-3 font-body">{collection}</p>
      <h1 class="font-display font-bold text-4xl text-dusk leading-tight mb-4">{title}</h1>
      <p class="text-lg text-gray-600 leading-relaxed">{intro}</p>
    </header>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {entries.map(entry => (
        <a
          href={`/${collection}/${entry.slug}`}
          class="group bg-white rounded-lg overflow-hidden border border-salt-dark hover:border-lagoon/40 hover:shadow-md transition-all duration-200"
        >
          {entry.data.heroImage && (
            <div class="aspect-video overflow-hidden">
              <img
                src={entry.data.heroImage}
                alt={entry.data.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            </div>
          )}
          <div class="p-5">
            {entry.data.tags?.length > 0 && (
              <div class="flex flex-wrap gap-1 mb-3">
                {entry.data.tags.slice(0,2).map((tag: string) => (
                  <span class="text-xs px-2 py-0.5 bg-lagoon/10 text-lagoon rounded-full">{tag}</span>
                ))}
              </div>
            )}
            <h2 class="font-display font-semibold text-lg text-dusk group-hover:text-lagoon transition-colors leading-snug mb-2">
              {entry.data.title}
            </h2>
            <p class="text-sm text-gray-500 leading-relaxed line-clamp-3">
              {entry.data.description}
            </p>
          </div>
        </a>
      ))}
    </div>

  </div>
</Base>
